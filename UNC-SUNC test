--[[
    nyx :: unc+sunc manifest-driven test suite
    - TESTS = list of { name, fn, expected } -- evidence-based, not just presence
    - runner executes, captures witness
    - reporter emits table + text + optional JSON
    - no hard-coded URL, source = this file
]]

-- =====================================================
-- core
-- =====================================================
local OUT = { lines = {}, pass = 0, fail = 0, skip = 0 }
local function emit(s, tag) OUT.lines[#OUT.lines+1] = { text = tostring(s), tag = tag } end
local function head(t) emit("[" .. t .. "] " .. string.rep("-", math.max(2, 50 - #t)), "sec") end

local function safe_call(fn, ...)
    local a = { pcall(fn, ...) }
    if not a[1] then return false, a[2] end
    return true, select(2, table.unpack(a))
end

local function ret_type(v) return type(v) == "userdata" and typeof(v) or type(v) end

-- =====================================================
-- TESTS -- manifest
-- each: { group, name, run = function -> ok, witness }
-- =====================================================
local TESTS = {}
local function T(group, name, run)
    TESTS[#TESTS+1] = { group = group, name = name, run = run }
end

-- ─── EXECUTION ───────────────────────────────────────
T("execution", "loadstring returns function", function()
    if type(loadstring) ~= "function" then return false, "missing" end
    local f = loadstring("return 1+1")
    local ok, r = safe_call(f)
    return ok and r == 2, "r=" .. tostring(r)
end)

T("execution", "loadstring preserves chunkname", function()
    if type(loadstring) ~= "function" then return false, "missing" end
    local f = loadstring("return 1", "=my_chunk")
    if not f then return false, "load fail" end
    local info = debug.getinfo and debug.getinfo(f)
    if not info then return true, "no getinfo, assumption ok" end
    return info.short_src and info.short_src:find("my_chunk", 1, true) ~= nil,
        "src=" .. tostring(info.short_src)
end)

T("execution", "loadstring with syntax error returns nil+err", function()
    if type(loadstring) ~= "function" then return false, "missing" end
    local f, e = loadstring("this is (bad lua")
    return f == nil and type(e) == "string" and #e > 0, "f=" .. tostring(f) .. " e=" .. tostring(e)
end)

-- ─── FILE SYSTEM ─────────────────────────────────────
T("fs", "writefile + readfile round trip", function()
    if type(writefile) ~= "function" or type(readfile) ~= "function" then
        return false, "missing"
    end
    local tok = "nyx_" .. tostring(math.random(1e12))
    local path = "nyx_fs_" .. tostring(math.random(1e9)) .. ".txt"
    local ok = pcall(function()
        writefile(path, tok)
        local got = readfile(path)
        if got ~= tok then error("got " .. tostring(got)) end
        delfile(path)
    end)
    return ok, path
end)

T("fs", "appendfile appends", function()
    if type(writefile) ~= "function" or type(appendfile) ~= "function"
        or type(readfile) ~= "function" then return false, "missing" end
    local path = "nyx_ap_" .. tostring(math.random(1e9)) .. ".txt"
    local ok = pcall(function()
        writefile(path, "a")
        appendfile(path, "b")
        if readfile(path) ~= "ab" then error("append mismatch") end
        delfile(path)
    end)
    return ok
end)

T("fs", "isfile reports false after delfile", function()
    if type(writefile) ~= "function" or type(delfile) ~= "function"
        or type(isfile) ~= "function" then return false, "missing" end
    local path = "nyx_del_" .. tostring(math.random(1e9)) .. ".txt"
    writefile(path, "x")
    local before = isfile(path)
    delfile(path)
    local after = isfile(path)
    return before == true and after == false, "before=" .. tostring(before) .. " after=" .. tostring(after)
end)

T("fs", "listfiles sees aritifacts from other scripts", function()
    if type(writefile) ~= "function" or type(listfiles) ~= "function" then
        return false, "missing"
    end
    local path = "nyx_list_" .. tostring(math.random(1e9)) .. ".txt"
    writefile(path, "x")
    local found = false
    for _, e in ipairs(listfiles(".")) do
        if e:find(path, 1, true) then found = true; break end
    end
    delfile(path)
    return found
end)

-- ─── HOOKFUNCTION ────────────────────────────────────
T("hook", "hookfunction intercepts calls to target", function()
    if type(hookfunction) ~= "function" or type(restorefunction) ~= "function" then
        return false, "missing"
    end
    local hits = 0
    local fn = function(a, b) return a + b end
    local ok, old = safe_call(hookfunction, fn, function(a, b)
        hits = hits + 1
        return old(a, b) * 100
    end)
    if not ok then return false, "hook threw: " .. tostring(old) end
    local r = fn(2, 3)
    restorefunction(fn)
    return r == 500 and hits == 1, "r=" .. tostring(r) .. " hits=" .. tostring(hits)
end)

T("hook", "hookfunction returns original that still works", function()
    if type(hookfunction) ~= "function" or type(restorefunction) ~= "function" then
        return false, "missing"
    end
    local fn = function(x) return x * 2 end
    local ok, old = safe_call(hookfunction, fn, function(x) return old(x) end)
    if not ok then return false, "hook threw" end
    local direct = old(5)
    restorefunction(fn)
    return direct == 10, "old(5)=" .. tostring(direct)
end)

T("hook", "restorefunction fully reverses hook", function()
    if type(hookfunction) ~= "function" or type(restorefunction) ~= "function" then
        return false, "missing"
    end
    local fn = function() return 1 end
    hookfunction(fn, function() return 2 end)
    local during = fn()
    restorefunction(fn)
    local after = fn()
    return during == 2 and after == 1, "during=" .. tostring(during) .. " after=" .. tostring(after)
end)

-- ─── NEWCCLOSURE ─────────────────────────────────────
T("closure", "newcclosure wraps but preserves return", function()
    if type(newcclosure) ~= "function" then return false, "missing" end
    local c = newcclosure(function(x) return x + 1 end)
    return c(41) == 42
end)

T("closure", "newcclosure passes iscclosure test", function()
    if type(newcclosure) ~= "function" or type(iscclosure) ~= "function" then
        return false, "missing"
    end
    local c = newcclosure(function() end)
    return iscclosure(c) == true
end)

T("closure", "checkcaller true inside newcclosure", function()
    if type(newcclosure) ~= "function" or type(checkcaller) ~= "function" then
        return false, "missing"
    end
    local got
    local c = newcclosure(function() got = checkcaller() end)
    c()
    return got == true
end)

-- ─── GETRAWMETATABLE ─────────────────────────────────
T("meta", "getrawmetatable returns writable table", function()
    if type(getrawmetatable) ~= "function" or type(setreadonly) ~= "function"
        or type(isreadonly) ~= "function" then return false, "missing" end
    local mt = getrawmetatable(game)
    if type(mt) ~= "table" then return false, "not table" end
    local was = isreadonly(mt)
    setreadonly(mt, false)
    local now = isreadonly(mt)
    setreadonly(mt, was)
    return now == false, "isreadonly after unprotect=" .. tostring(now)
end)

T("meta", "hookmetamethod ____namecall intercepts", function()
    if type(hookmetamethod) ~= "function" or type(getrawmetatable) ~= "function" then
        return false, "missing"
    end
    local hits = 0
    local ok = pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        local prev = hookmetamethod(game, "__namecall", function(self, ...)
            hits = hits + 1
            return old(self, ...)
        end)
        game:GetService("RunService")
        if type(restorefunction) == "function" then
            restorefunction(prev or mt.__namecall)
        end
    end)
    return ok and hits > 0, "hits=" .. tostring(hits)
end)

-- ─── GETCONNECTIONS ──────────────────────────────────
T("signal", "getconnections sees new connection", function()
    if type(getconnections) ~= "function" then return false, "missing" end
    local sig = game:GetService("RunService").Heartbeat
    local before = #getconnections(sig)
    local conn = sig:Connect(function() end)
    task.wait(0.05)
    local after = #getconnections(sig)
    conn:Disconnect()
    return after == before + 1, before .. " -> " .. after
end)

T("signal", "getconnections entries have Function/Enabled/Disconnect", function()
    if type(getconnections) ~= "function" then return false, "missing" end
    local sig = game:GetService("RunService").Heartbeat
    local conn = sig:Connect(function() end)
    local entries = getconnections(sig)
    conn:Disconnect()
    if #entries == 0 then return false, "empty" end
    for _, c in ipairs(entries) do
        if c.Function == nil or c.Enabled == nil or type(c.Disconnect) ~= "function" then
            return false, "entry missing fields"
        end
    end
    return true
end)

T("signal", "getconnections Disconnect affects count", function()
    if type(getconnections) ~= "function" then return false, "missing" end
    local sig = game:GetService("RunService").Heartbeat
    local conn = sig:Connect(function() end)
    task.wait(0.05)
    local entries = getconnections(sig)
    local target
    for _, c in ipairs(entries) do
        if c.Function ~= nil then target = c; break end
    end
    if not target then conn:Disconnect(); return false, "no entries" end
    local n_before = #getconnections(sig)
    pcall(target.Disconnect)
    task.wait(0.05)
    local n_after = #getconnections(sig)
    pcall(function() conn:Disconnect() end)
    return n_after <= n_before, n_before .. " -> " .. n_after
end)

-- ─── FIRESIGNAL ──────────────────────────────────────
T("fire", "firesignal triggers connected listener", function()
    if type(firesignal) ~= "function" then return false, "missing" end
    local fired = false
    local sig = Instance.new("BindableEvent")
    local conn = sig.Event:Connect(function(v) if v == "nyx" then fired = true end end)
    local ok = pcall(firesignal, sig.Event, "nyx")
    conn:Disconnect()
    sig:Destroy()
    return ok and fired, "ok=" .. tostring(ok) .. " fired=" .. tostring(fired)
end)

T("fire", "fireclickdetector reaches MouseClick", function()
    if type(fireclickdetector) ~= "function" then return false, "missing" end
    local part = Instance.new("Part"); part.Anchored = true; part.Parent = workspace
    local cd = Instance.new("ClickDetector"); cd.Parent = part
    local fired = false
    local conn = cd.MouseClick:Connect(function() fired = true end)
    local ok = pcall(fireclickdetector, cd)
    conn:Disconnect(); cd:Destroy(); part:Destroy()
    return ok and fired
end)

-- ─── GETGENV / GETRENV ───────────────────────────────
T("env", "getgenv returns same table each call", function()
    if type(getgenv) ~= "function" then return false, "missing" end
    return getgenv() == getgenv()
end)

T("env", "getgenv != getrenv", function()
    if type(getgenv) ~= "function" or type(getrenv) ~= "function" then
        return false, "missing"
    end
    return getgenv() ~= getrenv()
end)

T("env", "genv survives across loadstring chunks", function()
    if type(getgenv) ~= "function" or type(loadstring) ~= "function" then
        return false, "missing"
    end
    local f = loadstring([[
        getgenv().__unc_c = (getgenv().__unc_c or 0) + 1
        return getgenv().__unc_c
    ]])
    local a, b = f(), f()
    getgenv().__unc_c = nil
    return a == 1 and b == 2, "a=" .. tostring(a) .. " b=" .. tostring(b)
end)

-- ─── IDENTITY ────────────────────────────────────────
T("identity", "getthreadidentity returns number", function()
    if type(getthreadidentity) ~= "function" then return false, "missing" end
    return type(getthreadidentity()) == "number"
end)

T("identity", "setthreadidentity(2) sticks", function()
    if type(setthreadidentity) ~= "function" or type(getthreadidentity) ~= "function" then
        return false, "missing"
    end
    local orig = getthreadidentity()
    setthreadidentity(2)
    local at2 = getthreadidentity()
    setthreadidentity(orig)
    return at2 == 2, "at2=" .. tostring(at2)
