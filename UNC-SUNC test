-- esc closes
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Escape then
        -- only close if our gui is still alive
        if gui and gui.Parent then
            -- wait a beat to avoid racing with roblox menu
            task.wait(0.05)
            if gui and gui.Parent then
                -- don't destroy on first escape; roblox menu gets priority
            end
        end
    end
end)

