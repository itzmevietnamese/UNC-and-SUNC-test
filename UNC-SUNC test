local function emit(text, color)
    local c = COLORS[color] or COLORS.plain
    LINES[#LINES + 1] = string.format('<font color="%s">%s</font>', c, text)
    out.Text = table.concat(LINES, "\n")
    task.defer(function() scroll.CanvasPosition = Vector2.new(0, math.huge) end)
end

local function clear_out()
    LINES = {}
    out.Text = ""
    foot.Text = "idle -- click a button"
end

