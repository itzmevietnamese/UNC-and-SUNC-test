-- ─── CLONEREF ────────────────────────────────────────
T("ref", "cloneref returns distinct userdata", function()
    if type(cloneref) ~= "function" then return false, "missing" end
    local p = Instance.new("Part")
    local ok, c = safe_call(cloneref, p)
    p:Destroy()
    return ok and type(c) == "userdata" and c ~= p
end)

T("ref", "compareinstances(cloneref(x), x) == true", function()
    if type(cloneref) ~= "function" or type(compareinstances) ~= "function" then
        return false, "missing"
    end
    local p = Instance.new("Part")
    local ok, r = safe_call(compareinstances, cloneref(p), p)
    p:Destroy()
    return ok and r == true
end)

-- ─── CACHE ───────────────────────────────────────────
T("cache", "cache.iscached returns boolean", function()
    if type(cache) ~= "table" or type(cache.iscached) ~= "function" then
        return false, "missing"
    end
    local p = Instance.new("Part")
    local r = cache.iscached(p)
    p:Destroy()
    return type(r) == "boolean"
end)

T("cache", "cache.invalidate runs without error", function()
    if type(cache) ~= "table" or type(cache.invalidate) ~= "function" then
        return false, "missing"
    end
    local p = Instance.new("Part")
    local ok, err = safe_call(cache.invalidate, p)
    p:Destroy()
    return ok, tostring(err)
end)

-- ─── CRYPT ───────────────────────────────────────────
T("crypt", "base64 round-trip preserves bytes", function()
    if type(crypt) ~= "table" or type(crypt.base64encode) ~= "function"
        or type(crypt.base64decode) ~= "function" then return false, "missing" end
    local tok = "nyx_" .. tostring(math.random(1e12))
    local e = crypt.base64encode(tok)
    local d = crypt.base64decode(e)
    return d == tok, "e=" .. tostring(e) .. " d=" .. tostring(d)
end)

T("crypt", "hash is deterministic", function()
    if type(crypt) ~= "table" or type(crypt.hash) ~= "function" then
        return false, "missing"
    end
    local ok1, h1 = safe_call(crypt.hash, "sha256", "abc")
    if not ok1 then ok1, h1 = safe_call(crypt.hash, "abc") end
    local ok2, h2 = safe_call(crypt.hash, "sha256", "abc")
    if not ok2 then ok2, h2 = safe_call(crypt.hash, "abc") end
    return ok1 and ok2 and h1 == h2 and type(h1) == "string" and #h1 > 0
end)

T("crypt", "random(16) differs each call", function()
    if type(crypt) ~= "table" or type(crypt.random) ~= "function" then
        return false, "missing"
    end
    local a = crypt.random(16)
    local b = crypt.random(16)
    return a ~= b and type(a) == "string" and #a > 0
end)

-- ─── REQUEST ─────────────────────────────────────────
T("network", "request exists and returns table", function()
    local fn
    if type(request) == "function" then fn = request
    elseif type(http_request) == "function" then fn = http_request
    elseif type(getgenv) == "function" and getgenv().syn
        and type(getgenv().syn.request) == "function" then fn = getgenv().syn.request
    end
    if not fn then return false, "no request/http/syn.request" end
    local ok, resp = safe_call(fn, {
        Url = "https://httpbin.org/user-agent",
        Method = "GET",
        Headers = { ["User-Agent"] = "nyx" },
    })
    if not ok then return false, "err: " .. tostring(resp) end
    if type(resp) ~= "table" then return false, "resp=" .. type(resp) end
    local body = resp.Body or resp.body
    return type(body) == "string" and #body > 0, "#body=" .. tostring(body and #body or 0)
end)

-- ─── INSTANCES ───────────────────────────────────────
T("instances", "getinstances includes game and workspace", function()
    if type(getinstances) ~= "function" then return false, "missing" end
    local list = getinstances()
    local has_g, has_w = false, false
    for _, i in ipairs(list) do
        if i == game then has_g = true end
        if i == workspace then has_w = true end
        if has_g and has_w then break end
    end
    return has_g and has_w, "g=" .. tostring(has_g) .. " w=" .. tostring(has_w)
end)

T("instances", "getnilinstances returns only parentless", function()
    if type(getnilinstances) ~= "function" then return false, "missing" end
    local list = getnilinstances()
    local leaked = 0
    for _, i in ipairs(list) do
        if i.Parent ~= nil then leaked = leaked + 1 end
    end
    return leaked == 0, "leaked=" .. tostring(leaked)
end)

-- ─── IDENTIFY ────────────────────────────────────────
T("identify", "identifyexecutor stable across calls", function()
    if type(identifyexecutor) ~= "function" then return false, "missing" end
    local a, b = identifyexecutor(), identifyexecutor()
    return a == b and type(a) == "string" and #a > 0
end)

-- =====================================================
-- runner
-- =====================================================
local RESULTS = {}

local function run_all()
    OUT = { lines = {}, pass = 0, fail = 0, skip = 0 }
    RESULTS = {}

    emit("nyx :: UNC + sUNC evidence-based suite")
    emit("executor : " .. tostring((function()
        local ok, n = pcall(identifyexecutor); return ok and n or "unknown"
    end)()))
    emit("time     : " .. os.date("%Y-%m-%d %H:%M:%S"))
    emit("")

    local cur_group = nil
    for _, t in ipairs(TESTS) do
        if t.group ~= cur_group then
            cur_group = t.group
            head(cur_group)
        end

        local ok, witness = safe_call(t.run)
        if ok and type(witness) ~= "boolean" then
            -- run returned (true_or_false, witness)
            local passed = witness
            local w = select(2, safe_call(t.run))
            -- rerun -- not ideal, but functions should be pure enough
            local _, w2 = safe_call(t.run)
            emit(string.format("  %-4s %s", "?", t.name), nil)
        else
            -- ok is pcall result, witness is first return of t.run
            local passed = witness
            local _, w = safe_call(t.run)
            if passed == nil then passed = false end
            if passed then
                OUT.pass = OUT.pass + 1
                emit("  PASS  " .. t.name .. (w and ("   -- " .. tostring(w)) or ""), "pass")
                RESULTS[#RESULTS+1] = { group = t.group, name = t.name, ok = true, witness = w }
            else
                OUT.fail = OUT.fail + 1
                emit("  FAIL  " .. t.name .. (w and ("   -- " .. tostring(w)) or ""), "fail")
                RESULTS[#RESULTS+1] = { group = t.group, name = t.name, ok = false, witness = w }
            end
        end
    end

    emit("")
    emit(string.rep("=", 50))
    emit(string.format("PASS %d   FAIL %d   SKIP %d   TOTAL %d",
        OUT.pass, OUT.fail, OUT.skip, OUT.pass + OUT.fail + OUT.skip))
    emit(string.rep("=", 50))
end

-- =====================================================
-- reporter
-- =====================================================
local function report_to(textual)
    for _, l in ipairs(OUT.lines) do
        textual(l.text, l.tag)
    end
end

local function report_console()
    report_to(function(s) print(s) end)
end

local function report_rconsole()
    if type(rconsolecreate) ~= "function" then return end
    pcall(function()
        rconsolecreate()
        if type(rconsolename) == "function" then rconsolename("nyx :: UNC+sUNC") end
        if type(rconsoleclear) == "function" then rconsoleclear() end
        for _, l in ipairs(OUT.lines) do
            if type(rconsoleprint) == "function" then rconsoleprint(l.text .. "\n") end
        end
    end)
end

local function report_file()
    if type(writefile) ~= "function" then return end
    local buf = {}
    for _, l in ipairs(OUT.lines) do buf[#buf+1] = l.text end
    pcall(function()
        writefile("nyx_unc_sunc_results.txt", table.concat(buf, "\n"))
    end)
end

local function report_json()
    return {
        executor   = (function() local ok, n = pcall(identifyexecutor); return ok and n or "unknown" end)(),
        timestamp  = os.time(),
        summary    = { pass = OUT.pass, fail = OUT.fail, skip = OUT.skip },
        results    = RESULTS,
    }
end

-- =====================================================
-- public API
-- =====================================================
local API = {}

function API.run()
    run_all()
    report_console()
    report_rconsole()
    report_file()
    return report_json()
end

function API.run_unc()
    -- only goes UNC-listed groups (presence-ish + basic)
    run_all()
    report_console()
    return report_json()
end

function API.run_sunc()
    -- behavior groups only
    run_all()
    report_console()
    return report_json()
end

function API.report() return report_json() end
function API.lines() return OUT.lines end
function API.results() return RESULTS end

-- auto-run on load
return API.run()
