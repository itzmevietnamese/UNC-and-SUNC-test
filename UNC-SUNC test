-- =====================================================
-- log
-- =====================================================
local LINES, RAW = {}, {}

local COLORS = {
    pass   = "#78dc78",
    fail   = "#ff5a5a",
    warn   = "#e6c850",
    info   = "#7aaaff",
    dim    = "#888888",
    plain  = "#c8c8c8",
    accent = "#c878dc",
}

local function classify(text)
    local s = tostring(text)
    local low = s:lower()
    if s:find("PASS") or low:find("^%s*pass")   then return "pass" end
    if s:find("FAIL") or low:find("^%s*fail")   then return "fail" end
    if low:find("warn") or s:find("%[warn%]")   then return "warn" end
    if s:find("^%[")                            then return "info" end
    return "plain"
end

local function emit(text)
    local s = tostring(text)
    for line in (s .. "\n"):gmatch("([^\n]*)\n") do
        local tag = classify(line)
        local c = COLORS[tag]
        LINES[#LINES+1] = string.format('<font color="%s">%s</font>', c, line)
        RAW[#RAW+1] = line
    end
    if #LINES > 2000 then
        local cut = #LINES - 2000
        for _ = 1, cut do table.remove(LINES, 1); table.remove(RAW, 1) end
    end
    out.Text = table.concat(LINES, "\n")
    task.defer(function() scroll.CanvasPosition = Vector2.new(0, math.huge) end)
end

local function clear_out()
    LINES, RAW = {}, {}
    out.Text = ""
    foot.Text = "ready"
end

-- =====================================================
-- hook + run
-- =====================================================
local busy = false

local function run()
    if busy then return end
    busy = true
    foot.Text = "running..."

    emit("[nyx] begin -- fetch " .. URL)
    emit("[nyx] " .. os.date("%Y-%m-%d %H:%M:%S"))
    emit("")

    -- snapshot originals
    local real_print = print
    local real_warn  = warn
    local real_rcon  = nil
    if type(rconsoleprint) == "function" then real_rcon = rconsoleprint end

    -- indent helper to keep script output visually nested
    local function wrap(s)
        return s
    end

    -- hook print
    print = function(...)
        local parts = {}
        for i = 1, select("#", ...) do parts[i] = tostring(select(i, ...)) end
        emit(wrap(table.concat(parts, "\t")))
        pcall(real_print, ...)
    end

    -- hook warn
    warn = function(...)
        local parts = {}
        for i = 1, select("#", ...) do parts[i] = tostring(select(i, ...)) end
        emit(wrap("[warn] " .. table.concat(parts, "\t")))
        pcall(real_warn, ...)
    end

    -- hook rconsole print if available
    if real_rcon then
        rconsoleprint = function(s)
            emit(wrap(tostring(s):gsub("\n$", "")))
            pcall(real_rcon, s)
        end
    end

    local ok_all = pcall(function()
        -- 1. fetch
        local ok_src, src = pcall(function()
            return game:HttpGet(URL)
        end)
        if not ok_src or type(src) ~= "string" or #src == 0 then
            emit("[nyx] fetch failed: " .. tostring(src), "fail")
            return
        end
        emit(string.format("[nyx] fetched %d bytes", #src))

        -- 2. compile
        local fn, cerr = loadstring(src)
        if not fn then
            emit("[nyx] compile failed: " .. tostring(cerr), "fail")
            return
        end
        emit("[nyx] compiled -- running")
        emit("")

        -- 3. run
        local ok_run, rerr = pcall(fn)
        if not ok_run then
            emit("")
            emit("[nyx] runtime error: " .. tostring(rerr), "fail")
        else
            emit("")
            emit("[nyx] done")
        end
    end)

    -- restore
    print = real_print
    warn = real_warn
    if real_rcon then rconsoleprint = real_rcon end

    if not ok_all then
        emit("[nyx] wrapper error (should not happen)", "fail")
    end

    busy = false
    foot.Text = "finished -- " .. os.date("%H:%M:%S")
end

b_run.MouseButton1Click:Connect(function()
    clear_out()
    task.spawn(run)
end)

b_clear.MouseButton1Click:Connect(function()
    clear_out()
end)

b_copy.MouseButton1Click:Connect(function()
    if type(setclipboard) ~= "function" then
        foot.Text = "setclipboard unavailable"
        return
    end
    local ok = pcall(setclipboard, table.concat(RAW, "\n"))
    foot.Text = ok and ("copied " .. #RAW .. " lines") or "copy failed"
end)

-- =====================================================
-- drag
-- =====================================================
do
    local dragging, dragInput, dragStart, startPos
    titlebar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    titlebar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

